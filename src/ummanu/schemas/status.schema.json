{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/invalid"}
  ],
  "$defs": {
  "snapshot": {
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation", "host", "dispatcher", "checkpoint", "memory", "secret_store", "recovery"],
  "properties": {
    "schema_version": {"const": 1},
    "installation": {
      "type": "object",
      "required": ["name", "instance", "projects", "heads", "head_registry", "cards", "sprints"],
      "properties": {
        "cards": {"type": "object", "required": ["total", "active_attempts"]},
        "head_registry": {
          "type": "object",
          "required": ["snapshot", "canonical", "canonical_owner", "product_root", "revision", "error"],
          "properties": {
            "snapshot": {"type": "string"},
            "canonical": {"type": ["string", "null"]},
            "canonical_owner": {"type": ["string", "null"]},
            "product_root": {"type": ["string", "null"]},
            "revision": {"type": ["string", "null"]},
            "error": {"type": ["string", "null"]}
          }
        },
        "interactive_workspace": {
          "type": "object",
          "description": "The interactive head's workspace <data>/interactive and the digests of the shared and personal parts it was composed from.",
          "required": ["path", "present", "shared", "personal", "drifted", "error"],
          "properties": {
            "path": {"type": "string"},
            "present": {"type": "boolean"},
            "shared": {"type": ["string", "null"]},
            "personal": {"type": ["string", "null"], "description": "null when the live root has no persona/AGENTS.md"},
            "drifted": {"type": "boolean"},
            "error": {"type": ["string", "null"]}
          }
        },
        "sprints": {
          "type": "object",
          "required": ["items", "error"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref", "goal", "status", "current_task", "cards", "budget", "resume_freshness", "stop_reason", "observer", "degraded_cards"]
              }
            },
            "error": {
              "oneOf": [
                {"type": "null"},
                {"type": "object", "required": ["code", "message"]}
              ]
            }
          }
        }
      }
    },
    "host": {"type": "object", "required": ["units", "schedules", "inventory_errors", "resources"], "properties": {"resources": {"type": "object", "required": ["disk_free_bytes", "memory_available_bytes", "load_average"]}}},
    "dispatcher": {"type": "object", "required": ["phase", "active_attempts", "observers", "pause", "divergences", "reconciliation", "last_tick", "tick_statistics"], "properties": {"last_tick": {"type": ["object", "null"], "required": ["seq", "at", "status", "step", "healthy", "reason", "actions", "error_count", "degraded_count", "duration_ms", "phases"], "properties": {"duration_ms": {"type": ["number", "null"]}, "phases": {"type": ["object", "null"], "additionalProperties": {"type": "number", "minimum": 0}}}}, "pause": {"type": "object", "required": ["paused", "mode", "since", "actor", "auto_resume", "cards", "warnings"]}, "active_attempts": {"type": "array", "items": {"type": "object", "required": ["reference", "attempt_id", "head", "workspace", "watchdogs", "paused", "headless", "degraded"], "properties": {"watchdogs": {"type": "object", "required": ["worker", "reviewer"]}}}}, "observers": {"type": "array", "items": {"type": "object", "required": ["sprint", "head", "state", "alive", "launches", "last_action", "last_action_at", "deferred_reason"]}}, "divergences": {"type": "object", "required": ["open_count", "total_count", "open"]}, "reconciliation": {"type": "object", "required": ["last_tick_finished_at", "last_reconciled_at", "records_tracked"]}, "tick_statistics": {"type": "object", "required": ["sample_count", "p50_duration_ms", "p95_duration_ms"], "properties": {"sample_count": {"type": "integer", "minimum": 0, "maximum": 100}, "p50_duration_ms": {"type": ["number", "null"], "minimum": 0}, "p95_duration_ms": {"type": ["number", "null"], "minimum": 0}}}}},
    "checkpoint": {"type": "object", "required": ["last_commit", "lag_minutes", "remote_diverged", "blocked_reason", "checkpoint_duration_ms"], "properties": {"checkpoint_duration_ms": {"type": "number"}}},
    "memory": {"type": "object", "required": ["fact_count", "last_reindex_at", "index_present"]},
    "secret_store": {"type": "object", "required": ["initialized", "secret_count", "last_modified_at", "installation_key", "materialize"], "properties": {"installation_key": {"type": "object", "required": ["present", "usable"]}, "materialize": {"type": "array", "items": {"type": "object", "required": ["target", "path", "count"]}}}},
    "recovery": {
      "type": "object",
      "required": ["resources", "credential_consumers", "paths", "materializations", "bypasses", "catalog_envelope_divergences", "registry_error"],
      "properties": {
        "resources": {"type": "array"},
        "credential_consumers": {"type": "array"},
        "paths": {"type": "array"},
        "materializations": {"type": "array"},
        "bypasses": {"type": "array"},
        "catalog_envelope_divergences": {"type": "array", "items": {"type": "string"}},
        "registry_error": {"type": ["string", "null"]}
      }
    }
  }
  },
  "invalid": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "error", "findings"],
    "properties": {
      "schema_version": {"const": 1},
      "error": {"const": "invalid_instance"},
      "findings": {"type": "array", "items": {"type": "string"}}
    }
  }
  }
}
