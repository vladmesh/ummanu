{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-read.schema.json",
  "title": "Transport-independent read layer snapshots",
  "description": "The three documents ummanu.webproto returns. Every transport renders these and none of them may invent a field: a client that reads one of these reads all of them the same way.",
  "oneOf": [
    {"$ref": "#/$defs/system"},
    {"$ref": "#/$defs/task"},
    {"$ref": "#/$defs/events"}
  ],
  "$defs": {
    "source": {
      "type": "object",
      "description": "Whether one source answered, why not, and how old what is shown instead is.",
      "required": ["state", "reason", "observed_at", "data_age_seconds"],
      "properties": {
        "state": {"enum": ["available", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"]},
        "data_age_seconds": {"type": ["number", "null"]}
      }
    },
    "agent": {
      "type": "object",
      "required": ["ref", "role", "state", "reason", "evidence", "invariant"],
      "properties": {
        "ref": {"type": "string"},
        "role": {"enum": ["worker", "reviewer"]},
        "state": {"enum": ["running", "finished", "process_failed", "source_unavailable", "unknown"]},
        "reason": {"type": "string"},
        "project": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "run_lifecycle": {"type": ["string", "null"]},
        "attempt_id": {"type": ["string", "null"]},
        "workspace": {"type": ["string", "null"]},
        "card_state": {"type": ["string", "null"]},
        "evidence": {
          "type": "object",
          "required": ["kind", "heartbeat_state", "pid", "pid_file", "detail"],
          "properties": {
            "kind": {"const": "process_heartbeat"},
            "heartbeat_state": {"type": "string"},
            "pid": {"type": ["integer", "null"]},
            "pid_file": {"type": "string"},
            "detail": {"type": ["string", "null"]}
          }
        },
        "invariant": {"type": "string"}
      }
    },
    "head": {
      "type": "object",
      "description": "One head run the card recorded: its identity and liveness from the dispatcher record and the run directory its supervisor kept, its launch configuration from the routing snapshot that recorded it, and what the CLI actually resolved from that run's latest `attempt.usage` occurrence. The resolved fields are null (and `resolved_models` empty) until a phase of the run finished, or for an occurrence written before `attempt.usage` carried them.",
      "required": ["ref", "role", "run_id", "head", "current", "attempt", "adapter", "model", "model_source", "effort", "resolved_model", "resolved_models", "resolved_effort", "resolved_report_generation", "runtime", "state", "reason"],
      "properties": {
        "ref": {"type": "string"},
        "role": {"type": "string"},
        "run_id": {"type": "string"},
        "head": {"type": ["string", "null"]},
        "current": {"type": "boolean"},
        "attempt": {"type": ["integer", "null"]},
        "adapter": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "model_source": {"type": "string"},
        "effort": {"type": ["string", "null"]},
        "resolved_model": {"type": ["string", "null"]},
        "resolved_models": {"type": "array", "items": {"type": "string"}},
        "resolved_effort": {"type": ["string", "null"]},
        "resolved_report_generation": {"type": ["integer", "null"]},
        "runtime": {"type": ["string", "null"]},
        "state": {"enum": ["running", "finished", "unknown"]},
        "reason": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "required": ["cursor", "typed", "kind", "ref", "occurred_at", "actor", "reason", "outcome", "transition", "related_refs", "data"],
      "properties": {
        "cursor": {"type": "string"},
        "typed": {"type": "boolean"},
        "kind": {"type": "string"},
        "event_id": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "ref": {"type": "string"},
        "occurred_at": {"type": ["string", "null"]},
        "actor": {"type": ["object", "null"]},
        "reason": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]},
        "transition": {"type": ["object", "null"]},
        "related_refs": {"type": "array", "items": {"type": "string"}},
        "data": {"type": "object"}
      }
    },
    "system": {
      "type": "object",
      "required": ["schema_version", "kind", "observed_at", "installation", "projects", "tasks", "agents"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "system"},
        "observed_at": {"type": "string"},
        "installation": {
          "type": "object",
          "required": ["instance", "name", "data_dir", "health"],
          "properties": {
            "instance": {"type": "string"},
            "name": {"type": ["string", "null"]},
            "data_dir": {"type": "string"},
            "health": {
              "type": "object",
              "required": ["source", "status"],
              "properties": {
                "source": {"$ref": "#/$defs/source"},
                "status": {"type": ["object", "null"]},
                "doctor": {"$ref": "#/$defs/recorded_doctor"},
                "combined": {
                  "type": "object",
                  "properties": {
                    "colour": {"enum": ["red", "yellow", "green", "unknown"]},
                    "findings": {"type": "array", "items": {"type": "object"}},
                    "problems": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        },
        "projects": {
          "type": "object",
          "required": ["source", "items"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "repo", "remote", "adapter", "default_branch", "plane", "enabled"],
                "properties": {"id": {"type": "string"}, "enabled": {"type": "boolean"}}
              }
            }
          }
        },
        "tasks": {
          "type": "object",
          "required": ["source", "items"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/task_row"}}
          }
        },
        "agents": {
          "type": "object",
          "required": ["source", "items"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
          }
        }
      }
    },
    "recorded_doctor": {
      "type": "object",
      "description": "Last completed attempt and current collection metadata. Unknown means not yet collected; invalid or failed readings remain explicit errors. Only collection begun after the completed attempt is current.",
      "required": ["state", "reason", "run_at", "completed_at", "exit_code", "findings", "collecting"],
      "properties": {
        "state": {"enum": ["available", "unknown", "failed", "unavailable", "stale", "malformed", "wrong_installation", "wrong_mode"]},
        "reason": {"type": ["string", "null"]},
        "run_at": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "findings": {"type": "array", "items": {"type": "object"}},
        "collecting": {
          "type": ["object", "null"],
          "required": ["run_at", "mode", "elapsed_seconds", "threshold_seconds", "stuck"],
          "properties": {
            "run_at": {"type": "string"},
            "mode": {"enum": ["live", "offline", "host_fixture"]},
            "elapsed_seconds": {"type": "number", "minimum": 0},
            "threshold_seconds": {"const": 60},
            "stuck": {"type": "boolean"}
          }
        }
      }
    },
    "task_row": {
      "type": "object",
      "required": ["ref", "title", "state", "project", "sprint", "type", "blocked_by", "claimed_by", "created_at", "updated_at"],
      "properties": {
        "ref": {"type": "string"},
        "title": {"type": "string"},
        "state": {"type": "string"},
        "project": {"type": ["string", "null"]},
        "sprint": {"type": ["string", "null"]},
        "type": {"type": ["string", "null"]},
        "blocked_by": {"type": ["string", "null"]},
        "claimed_by": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"]}
      }
    },
    "marker": {
      "type": ["object", "null"],
      "required": ["marker", "value", "at", "body", "classification"],
      "properties": {
        "marker": {"type": "string"},
        "value": {"type": "string"},
        "at": {"type": ["string", "null"]},
        "body": {"type": "string"},
        "classification": {"type": ["string", "null"]}
      }
    },
    "po_execution_resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replaces": {"type": "string"},
        "via": {"const": "create_session"},
        "session": {"type": "string"},
        "cli": {"type": "string"},
        "model": {"type": "string"},
        "effort": {"type": "string"}
      }
    },
    "po_execution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["request", "purpose", "sources", "initial", "executor", "successors"],
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["e2e_budget", "e2e_disposition"]},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "initial": {"$ref": "#/$defs/po_execution_resolution"},
        "executor": {"type": "string"},
        "successors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/po_execution_resolution"}}
      }
    },
    "e2e_disposition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "action", "holder", "reason"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "status": {"enum": ["waiting", "neutral", "follow_up", "settled"]},
        "action": {"enum": ["", "retry", "decline", "follow_up"]},
        "holder": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "completion": {"type": "string", "minLength": 1}
      },
      "description": "Durable native PO completion effect on one actual after-merge run. Empty holder means historical operation evidence only; retry grants no budget."
    },
    "task_e2e": {
      "type": ["object", "null"],
      "properties": {
        "hotfix_route": {
          "type": "object", "additionalProperties": false,
          "required": ["carrier", "run", "result"],
          "properties": {
            "carrier": {"type": "string", "minLength": 1},
            "run": {"type": "string", "minLength": 1},
            "result": {"$ref": "#/$defs/e2e_disposition_result"}
          }
        },
        "waiting_on": {"type": "string", "minLength": 1},
        "after_merge_runs": {
          "type": "array",
          "items": {"type": "object", "properties": {"disposition_result": {"$ref": "#/$defs/e2e_disposition_result"}}}
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["schema_version", "kind", "observed_at", "ref", "card", "project", "attempt", "agents", "heads", "work", "events"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "task"},
        "observed_at": {"type": "string"},
        "ref": {"type": "string"},
        "card": {
          "type": "object",
          "required": ["source", "value"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "value": {"type": ["object", "null"], "properties": {"po_execution": {"$ref": "#/$defs/po_execution"}, "e2e": {"$ref": "#/$defs/task_e2e"}}}
          }
        },
        "project": {
          "type": "object",
          "required": ["id", "registered", "binding"],
          "properties": {
            "id": {"type": ["string", "null"]},
            "registered": {"type": "boolean"},
            "binding": {"type": ["object", "null"]}
          }
        },
        "attempt": {
          "type": "object",
          "required": ["source", "value"],
          "properties": {"source": {"$ref": "#/$defs/source"}, "value": {"type": ["object", "null"]}}
        },
        "agents": {
          "type": "object",
          "required": ["source", "items"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
          }
        },
        "heads": {
          "type": "object",
          "required": ["source", "items"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/head"}}
          }
        },
        "work": {
          "type": "object",
          "required": ["worker_report", "review_verdict", "decision", "outcome"],
          "properties": {
            "worker_report": {"$ref": "#/$defs/marker"},
            "review_verdict": {"$ref": "#/$defs/marker"},
            "decision": {"$ref": "#/$defs/marker"},
            "outcome": {
              "type": ["object", "null"],
              "required": ["kind", "value", "at", "terminal"],
              "properties": {
                "kind": {"enum": ["report", "review", "decision"]},
                "value": {"type": "string"},
                "at": {"type": ["string", "null"]},
                "terminal": {"type": "boolean"}
              }
            }
          }
        },
        "events": {
          "type": "object",
          "required": ["source", "items", "next_cursor"],
          "properties": {
            "source": {"$ref": "#/$defs/source"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/event"}},
            "next_cursor": {"type": "string"}
          }
        }
      }
    },
    "events": {
      "type": "object",
      "required": ["schema_version", "kind", "observed_at", "ref", "source", "cursor", "next_cursor", "has_more", "items"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "task_events"},
        "observed_at": {"type": "string"},
        "ref": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "cursor": {"type": ["string", "null"]},
        "next_cursor": {"type": "string"},
        "has_more": {"type": "boolean"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}
