{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provision-task.schema.json",
  "title": "Provision task document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "identity", "input_revision", "scanner", "unresolved", "constraints"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "adapter", "default_branch"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repo": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "default_branch": {"type": "string", "minLength": 1}
      }
    },
    "input_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner_head"],
      "properties": {
        "scanner_head": {"type": "string", "minLength": 1}
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "findings"],
      "properties": {
        "facts": {"type": "object"},
        "findings": {"type": "array"}
      }
    },
    "unresolved": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_enabled", "adapter_storage", "project_local_requires_opt_in"],
      "properties": {
        "binding_enabled": {"const": false},
        "adapter_storage": {"const": "external"},
        "project_local_requires_opt_in": {"const": true},
        "project_local_allowed": {"type": "boolean"},
        "plane": {"type": "string"},
        "policy": {"type": "object"}
      }
    }
  }
}
