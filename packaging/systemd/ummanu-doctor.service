[Unit]
Description=Record the latest Ummanu doctor result
After=network-online.target

[Service]
Type=oneshot
User={{UMMANU_RUNTIME_USER}}
Group={{UMMANU_RUNTIME_USER}}
WorkingDirectory={{UMMANU_PRODUCT_ROOT}}
EnvironmentFile=-{{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=HOME={{UMMANU_RUNTIME_HOME}}
Environment=UMMANU_INSTANCE={{UMMANU_INSTANCE_PATH}}
Environment=UMMANU_REPO={{UMMANU_PRODUCT_ROOT}}
Environment=UMMANU_RUNTIME_ENV_FILE={{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=PATH={{UMMANU_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Nice=10
# The product kills the collector process group after 40 seconds. This outer
# bound includes publication/cleanup and kills the entire unit on interruption.
TimeoutStartSec=50
KillMode=control-group
ExecStart={{UMMANU_PRODUCT_ROOT}}/.venv/bin/ummanu doctor-record --instance {{UMMANU_INSTANCE_PATH}} --data-dir {{UMMANU_DATA_DIR}}

