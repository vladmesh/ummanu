[Unit]
Description=Ummanu instance repository maintenance (git gc outside any tick)
After=network-online.target

[Service]
Type=oneshot
User={{UMMANU_RUNTIME_USER}}
Group={{UMMANU_RUNTIME_USER}}
WorkingDirectory={{UMMANU_PRODUCT_ROOT}}
EnvironmentFile=-{{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=HOME={{UMMANU_RUNTIME_HOME}}
Environment=UMMANU_INSTANCE={{UMMANU_INSTANCE_PATH}}
Environment=UMMANU_REPO={{UMMANU_PRODUCT_ROOT}}
Environment=UMMANU_RUNTIME_ENV_FILE={{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=PATH={{UMMANU_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Packing yields to the ticks: it never takes the state-repo lock while it packs, and it gets
# the CPU and disk only when nothing else wants them.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
# systemd's default 90 s start timeout would kill a oneshot mid-pack.  The product bounds the pack
# at instance_maintenance.GC_TIMEOUT_SECONDS (4 h) and the reflog step at REFLOG_TIMEOUT_SECONDS;
# this outer bound leaves 30 min on top of both, so the product's own refusal fires first and
# lands in the journal.  The unit test holds the relation.
TimeoutStartSec=16200
ExecStart={{UMMANU_PRODUCT_ROOT}}/.venv/bin/ummanu instance-maintenance --instance {{UMMANU_INSTANCE_PATH}}
