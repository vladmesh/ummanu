[Unit]
Description=Ummanu web transport (loopback only; published by ummanu-web-front.service)
After=network.target

[Service]
Type=simple
User={{UMMANU_RUNTIME_USER}}
Group={{UMMANU_RUNTIME_USER}}
WorkingDirectory={{UMMANU_PRODUCT_ROOT}}
EnvironmentFile=-{{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=UMMANU_INSTANCE={{UMMANU_INSTANCE_PATH}}
Environment=UMMANU_REPO={{UMMANU_PRODUCT_ROOT}}
Environment=UMMANU_RUNTIME_ENV_FILE={{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=UMMANU_DATA_DIR={{UMMANU_DATA_DIR}}
Environment=PATH={{UMMANU_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 127.0.0.1 is not a default this unit may relax: the transport has no password of its own and its
# POST routes raise real heads, so the guarded front is the only path in from off this host.
ExecStart={{UMMANU_PRODUCT_ROOT}}/.venv/bin/ummanu web-serve --instance {{UMMANU_INSTANCE_PATH}} --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
