[Unit]
Description=Ummanu PO head service (the one owner of PO turns; fed by DATA_DIR/po-queue over DATA_DIR/po-service/po.sock)
After=network.target

[Service]
Type=simple
User={{UMMANU_RUNTIME_USER}}
Group={{UMMANU_RUNTIME_USER}}
WorkingDirectory={{UMMANU_PRODUCT_ROOT}}
EnvironmentFile=-{{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=UMMANU_INSTANCE={{UMMANU_INSTANCE_PATH}}
Environment=UMMANU_REPO={{UMMANU_PRODUCT_ROOT}}
Environment=UMMANU_RUNTIME_ENV_FILE={{UMMANU_INSTANCE_PATH}}/runtime.env
Environment=UMMANU_DATA_DIR={{UMMANU_DATA_DIR}}
Environment=PATH={{UMMANU_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# No PartOf=/BindsTo= the web: restarting the web must not touch a running turn. A turn is a child in
# this unit's control group, so a restart of this unit ends it; `ummanu upgrade` therefore only asks
# for a restart, and the service exits by itself (status 0) once no turn runs. Restart=always brings it
# back on the new code, and the queue on disk is taken up where it was.
ExecStart={{UMMANU_PRODUCT_ROOT}}/.venv/bin/ummanu po-serve --instance {{UMMANU_INSTANCE_PATH}}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
